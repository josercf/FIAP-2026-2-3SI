# Copie para .env antes do primeiro comando:
#
#     cp .env.exemplo .env
#
# O .env não vai para o Git (veja .gitignore). Endereço de serviço nunca fica
# cravado no código: vem daqui, com padrão de desenvolvimento local. Mesma
# regra do contrato da plataforma (ADR-006 e ADR-008).

# --- Banco -----------------------------------------------------------------
LOGITECH_DB_PASSWORD=logitech

# O nome da variável é o do contrato; o valor é escrito na sintaxe que a
# ferramenta de cada stack exige. Aqui quem lê é o psycopg, então é a forma
# libpq. Na Aula 05 a mesma variável valia um `jdbc:postgresql://...`.
LOGITECH_DB_URL=postgresql://logitech:logitech@localhost:5432/logitech

# --- Serviços da plataforma ------------------------------------------------
LOGITECH_RAG_URL=http://localhost:8010

# Consumido pela ferramenta OPCIONAL consultar_pedido (TODO-6b). Aponte para o
# seu fork da Aula 05, se ele estiver de pé. Sem isso, a ferramenta responde
# com isError e o motivo, que é o comportamento correto.
LOGITECH_PEDIDOS_URL=http://localhost:8080

# --- IA local (ADR-005) ----------------------------------------------------
LOGITECH_OLLAMA_URL=http://localhost:11434

# Modelo de embedding. A dimensão da coluna `vector(768)` é a DELE: trocar o
# modelo obriga a recriar a coluna e a reindexar tudo.
LOGITECH_EMBEDDING_MODELO=paraphrase-multilingual

# Modelo de conversa, usado só na etapa de geração. A recuperação, que é o que
# esta aula cobra, não depende dele.
LOGITECH_MODELO=qwen2.5:1.5b
