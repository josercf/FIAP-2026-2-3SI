# Copie para `.env` e ajuste. O `.env` esta no `.gitignore` e nunca vai para
# o repositorio: credencial em arquivo versionado e o erro que esta aula
# existe para nao repetir.
#
#     cp .env.exemplo .env

# Senha do console administrativo do Keycloak, em http://localhost:8090.
# Usuario: admin.
LOGITECH_KEYCLOAK_ADMIN_PASSWORD=troque-esta-senha
