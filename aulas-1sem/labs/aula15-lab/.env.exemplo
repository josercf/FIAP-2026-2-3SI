# Copie para .env antes do primeiro comando:
#
#     cp .env.exemplo .env
#
# O .env não vai para o Git (veja .gitignore).

# --- O interruptor da ADR-009 ----------------------------------------------
#
# Padrão `true` a partir desta aula. O Passo 2 manda pôr `false` para ver a
# injeção funcionar, e o Passo 3 devolve para `true`.
#
# Ele é declarado de propósito, aparece no README e no slide. Um caminho
# desligado que ninguém documenta é porta dos fundos; documentado e verificado,
# é o que permite comparar o antes e o depois na mesma máquina.
LOGITECH_GUARDRAILS_ATIVOS=true

# --- IA local (ADR-005) ----------------------------------------------------
LOGITECH_MODELO=qwen2.5:1.5b
LOGITECH_OLLAMA_URL=http://localhost:11434

# --- Serviços ---------------------------------------------------------------
LOGITECH_GATEWAY_URL=http://localhost:4000
LOGITECH_RAG_URL=http://localhost:8010

# Limite de taxa do gateway, por cliente e por minuto.
LOGITECH_IA_LIMITE_POR_MINUTO=20
