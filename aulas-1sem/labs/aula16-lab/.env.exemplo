# Copie para .env antes do primeiro comando:
#
#     cp .env.exemplo .env
#
# O .env não vai para o Git (veja .gitignore). Segredo nunca entra no
# docker-compose.yml, que é versionado e público.

# --- Banco -----------------------------------------------------------------
LOGITECH_DB_PASSWORD=logitech

# --- Identidade ------------------------------------------------------------
# Console do Keycloak em http://localhost:8090, usuário admin.
LOGITECH_KEYCLOAK_ADMIN_SENHA=admin

# Credencial que o servidor MCP usa para falar com o `rag` e o `pedidos`.
# Caminho de LABORATÓRIO, declarado como tal: senha em variável de ambiente não
# é o que se faz em produção, e o fluxo das pessoas é o PKCE pelo navegador.
LOGITECH_MCP_USUARIO=carla.admin
LOGITECH_MCP_SENHA=logitech

# --- IA local (ADR-005) ----------------------------------------------------
LOGITECH_IA_MODELO_LOCAL=qwen2.5:1.5b
LOGITECH_EMBEDDING_MODELO=paraphrase-multilingual
LOGITECH_MODELO=qwen2.5:1.5b

# Vazia de propósito: é o que faz o fallback do AI Gateway acontecer de
# verdade em vez de encenado. Se o professor tiver uma chave, basta preencher.
LOGITECH_IA_REMOTA_CHAVE=
